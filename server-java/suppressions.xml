<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
        "-//Checkstyle//DTD Suppressions 1.2//EN"
        "https://checkstyle.org/dtds/suppressions_1_2.dtd">
<!--
  逐条豁免说明(SPEC-JAVA §3.12 要求:checkstyle 违规必须修复,确需豁免的在此登记并注明理由):
  - Spring @Service 构造器注入的参数数量由依赖关系决定,拆分会破坏构造器注入的可读性,
    对参数超 7 的构造器精确豁免 ParameterNumberCheck(仅限构造器签名行区间);
  - StockCoreService.insertTransaction 为 8/9 参私有方法(与 StockTransaction 字段一一对应,
    属核心业务落库路径,不改签名),精确豁免 ParameterNumberCheck(仅限该方法所在行区间);
  - V9 加字段后新增的"兼容旧签名构造器"(保留旧参数量,既有测试不动)参数超 7,
    对 6 个 DTO 的兼容构造器精确豁免 ParameterNumberCheck(仅限构造器签名行区间);
  - V10 再补字段后,上述 DTO 的 canonical 构造器参数继续增长,并新增"兼容 V9 签名
    构造器"(参数超 7),WarehouseVO 兼容构造器 10 参,同按构造器签名行区间精确豁免。
-->
<suppressions>
    <!-- 入库单服务构造器:10 个依赖注入(Mapper/StockCoreService/DocNoService 等),属 Spring 构造器注入 -->
    <suppress files="[\\/]InboundServiceImpl\.java" checks="ParameterNumberCheck" lines="107-116"/>
    <!-- 出库单服务构造器:10 个依赖注入,属 Spring 构造器注入 -->
    <suppress files="[\\/]OutboundServiceImpl\.java" checks="ParameterNumberCheck" lines="108-117"/>
    <!-- 销售订单服务构造器:11 个依赖注入(含 ApprovalGuard),属 Spring 构造器注入 -->
    <suppress files="[\\/]SalesOrderServiceImpl\.java" checks="ParameterNumberCheck" lines="110-116"/>
    <!-- 库存调整单服务构造器:9 个依赖注入(含 ApprovalGuard),属 Spring 构造器注入 -->
    <suppress files="[\\/]StockAdjustServiceImpl\.java" checks="ParameterNumberCheck" lines="97-103"/>
    <!-- 盘点单服务构造器:9 个依赖注入(含 ApprovalGuard),属 Spring 构造器注入 -->
    <suppress files="[\\/]StocktakeServiceImpl\.java" checks="ParameterNumberCheck" lines="100-106"/>
    <!-- 采购订单服务构造器:8 个依赖注入(含 ApprovalGuard),属 Spring 构造器注入 -->
    <suppress files="[\\/]PurchaseOrderServiceImpl\.java" checks="ParameterNumberCheck" lines="98-104"/>
    <!-- 调拨单服务构造器:8 个依赖注入(含 ApprovalGuard),属 Spring 构造器注入 -->
    <suppress files="[\\/]TransferServiceImpl\.java" checks="ParameterNumberCheck" lines="93-99"/>
    <!-- StockCoreService.insertTransaction 为 8/9 参私有方法(与 StockTransaction 字段一一对应,
         属核心业务落库路径,不改签名),精确豁免 ParameterNumberCheck(仅限两重载签名行区间) -->
    <suppress files="[\\/]StockCoreService\.java" checks="ParameterNumberCheck" lines="844-890"/>
    <!-- V9/V10 兼容旧签名构造器(既有测试/调用不动,参数数等于旧签名),精确豁免(仅限签名行区间) -->
    <suppress files="[\\/]SupplierCreateDTO\.java" checks="ParameterNumberCheck" lines="45-55"/>
    <suppress files="[\\/]SupplierUpdateDTO\.java" checks="ParameterNumberCheck" lines="43-53"/>
    <suppress files="[\\/]CustomerCreateDTO\.java" checks="ParameterNumberCheck" lines="45-55"/>
    <suppress files="[\\/]CustomerUpdateDTO\.java" checks="ParameterNumberCheck" lines="43-53"/>
    <suppress files="[\\/]ItemCreateDTO\.java" checks="ParameterNumberCheck" lines="42-52"/>
    <suppress files="[\\/]ItemUpdateDTO\.java" checks="ParameterNumberCheck" lines="43-52"/>
    <suppress files="[\\/]InboundCreateDTO\.java" checks="ParameterNumberCheck" lines="50-53"/>
    <suppress files="[\\/]OutboundCreateDTO\.java" checks="ParameterNumberCheck" lines="50-53"/>
    <suppress files="[\\/]PurchaseOrderCreateDTO\.java" checks="ParameterNumberCheck" lines="55-58"/>
    <suppress files="[\\/]SalesOrderCreateDTO\.java" checks="ParameterNumberCheck" lines="56-59"/>
    <suppress files="[\\/]WarehouseVO\.java" checks="ParameterNumberCheck" lines="26-29"/>
    <!-- V11 单据号服务构造器:新增采购退货/销售退货 Mapper 后 9 个依赖注入,属 Spring 构造器注入 -->
    <suppress files="[\\/]DocNoService\.java" checks="ParameterNumberCheck" lines="109-113"/>
    <!-- V11 采购退货单服务构造器:8 个依赖注入(Mapper/OutboundService/DocNoService 等),属 Spring 构造器注入 -->
    <suppress files="[\\/]PurchaseReturnServiceImpl\.java" checks="ParameterNumberCheck" lines="98-102"/>
    <!-- V11 销售退货单服务构造器:8 个依赖注入(Mapper/InboundService/DocNoService 等),属 Spring 构造器注入 -->
    <suppress files="[\\/]SalesReturnServiceImpl\.java" checks="ParameterNumberCheck" lines="98-102"/>
</suppressions>
